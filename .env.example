# MSME360 Environment Configuration

# Server
PORT=8000
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_characters

# Relational Database (PostgreSQL 15+ or SQLite fallback)
DATABASE_URL=sqlite:///./msme360.db

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Business Settings
DEFAULT_CURRENCY=INR

# Groq AI Business Copilot (Supply your Groq API key in .env)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
