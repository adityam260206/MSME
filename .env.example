# MSME360 Environment Configuration

# Server
PORT=8000
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_characters

# Relational Database (PostgreSQL 15+)
DATABASE_URL=postgresql://msme_user:msme_password@localhost:5432/msme360

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Business Settings
DEFAULT_CURRENCY=INR

# Groq AI Business Copilot (Supply your Groq API key here)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
